VITE_CONSULTATION_ENDPOINT=/api/consultation
VITE_CHAT_LEAD_ENDPOINT=/api/chat-lead
VITE_EVENT_ENDPOINT=/api/event-registration

# Base URL of the abbadev-events API (Laravel). When set, the /seminar page uses
# the real two-step register + GCash receipt-upload flow against this API; when
# empty, /seminar falls back to the simpler reserve-then-pay panel. Set this and
# rebuild to switch the funnel over.
VITE_EVENTS_API=https://api.abbadev.com

# Server-side only. Put real values in the VPS environment file or process manager.
N8N_WEBHOOK_URL=https://n8nautomation.abbadev.com/webhook/abbadev-consultation
# Optional: dedicated workflow for chat-assistant leads. Falls back to N8N_WEBHOOK_URL when unset.
N8N_CHAT_WEBHOOK_URL=https://n8nautomation.abbadev.com/webhook/abbadev-chat-lead
# Optional: dedicated workflow for seminar/webinar registrations. Falls back to N8N_WEBHOOK_URL when unset.
N8N_EVENT_WEBHOOK_URL=https://n8nautomation.abbadev.com/webhook/abbadev-event-registration
N8N_JWT=replace-with-your-consultation-token
# Optional: dedicated secret for the chat webhook. Falls back to N8N_JWT when unset.
N8N_CHAT_JWT=replace-with-your-chat-token
# Optional: dedicated secret for the event webhook. Falls back to N8N_JWT when unset.
N8N_EVENT_JWT=replace-with-your-event-token
ALLOWED_ORIGIN=https://abbadev.com
PORT=8787
